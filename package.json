{
  "name": "smart-calculator",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "postinstall": "node -e \"try{const fs=require('fs');const p='node_modules/metro-config/src/loadConfig.js';let c=fs.readFileSync(p,'utf8');fs.writeFileSync(p,c.replace(/configs\\.toReversed\\(\\)/g,'[...configs].reverse()').replace(/reversedConfigs\\.toReversed\\(\\)/g,'[...reversedConfigs].reverse()'));console.log('metro-config patched')}catch(e){}\""
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testPathPattern": "__tests__/.*\\.test\\.ts$"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "babel-preset-expo": "^55.0.21",
    "expo": "~54.0.33",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "^3.16.7"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "typescript": "^5.9.3"
  },
  "private": true
}
